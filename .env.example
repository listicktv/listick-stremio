# listick-stremio settings: copy to .env and set LISTICK_URL and TMDB_ACCESS_TOKEN.

# your Listick's URL, for example https://listick.example.com
LISTICK_URL=

# TMDB API Read Access Token (themoviedb.org › Settings › API): title details and search. Without it: catalogs only
TMDB_ACCESS_TOKEN=
# optional: TheTVDB API key, for shows' episode order
TVDB_API_KEY=

# only if more than one reverse proxy sits in front (for example Cloudflare, then your own): 2
LISTICK_TRUSTED_PROXIES=
